# PostVisit AI - Environment Configuration Template
# Duplicate this file to .env and insert your actual API credentials.
# NEVER commit .env to version control!

# LLM / Groq Configuration
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=

# Supabase Persistence (Stage 2)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=postvisit-media

# API & Upload Limits
MAX_UPLOAD_SIZE_MB=100
API_VERSION=1.0.0

# Optional: custom base URL if using local or proxy provider
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

